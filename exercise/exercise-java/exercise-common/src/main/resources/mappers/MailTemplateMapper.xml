<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exercise.mappers.MailTemplateMapper">

    <resultMap id="mailTemplateMap" type="com.exercise.campus.entity.po.MailTemplate">
        <id property="templateId" column="template_id"/>
        <result property="templateType" column="template_type"/>
        <result property="name" column="name"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="enabled" column="enabled"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="allColumns">
        template_id, template_type, name, title, content, enabled, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.exercise.campus.entity.po.MailTemplate">
        INSERT INTO mail_template (<include refid="allColumns"/>)
        VALUES (
            #{templateId}, #{templateType}, #{name}, #{title}, #{content},
            #{enabled}, NOW(), NOW()
        )
    </insert>

    <update id="updateById" parameterType="com.exercise.campus.entity.po.MailTemplate">
        UPDATE mail_template
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            update_time = NOW()
        </set>
        WHERE template_id = #{templateId}
    </update>

    <delete id="deleteById">
        DELETE FROM mail_template WHERE template_id = #{templateId}
    </delete>

    <select id="selectById" resultMap="mailTemplateMap">
        SELECT <include refid="allColumns"/> FROM mail_template WHERE template_id = #{templateId}
    </select>

    <select id="selectByType" resultMap="mailTemplateMap">
        SELECT <include refid="allColumns"/> FROM mail_template WHERE template_type = #{templateType} LIMIT 1
    </select>

    <select id="selectList" resultMap="mailTemplateMap">
        SELECT <include refid="allColumns"/> FROM mail_template ORDER BY template_type ASC
    </select>
</mapper>