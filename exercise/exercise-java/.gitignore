# exercise-java 专用 .gitignore
# 适用 Spring Boot 3 + Maven 多模块

# ---- Maven 构建产物 ----
target/
build/
out/
*.class
*.jar
!*/lib/*.jar
!**/src/main/**/lib/
!**/src/test/**/lib/
.flattened-pom.xml

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
nbproject/

# ---- 日志 / 临时 ----
*.log
logs/
*.tmp
*.bak
*.swp

# ---- Spring Boot ----
HELP.md
application-prod.yml
application-prod.yaml
application-prod.properties
application-staging.yml
application-staging.yaml
application-local.yml
application-local.yaml
application-test.yml

# ---- 密钥 / 凭据 ----
*.jks
*.p12
*.pem
*.key
secret/
credentials/
secrets.yml
secrets.yaml

# ---- 生成的源码 ----
**/target/generated-sources/
**/target/generated-test-sources/
**/target/test-classes/

# ---- Maven wrapper 缓存 ----
.mvn/wrapper/maven-wrapper.jar

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini
