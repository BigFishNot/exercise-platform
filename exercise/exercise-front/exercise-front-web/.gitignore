# exercise-front-web 专用 .gitignore
# Vue 3 + Vite + Ant Design Vue

# ---- 依赖 ----
node_modules/
.pnpm-store/
.yarn/

# ---- 构建产物 ----
dist/
dist-ssr/
build/
*.local

# ---- 缓存 ----
.vite/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ---- 日志 ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ---- 环境变量 ----
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 测试覆盖率 ----
coverage/
.nyc_output/

# ---- 其它 ----
.history/
